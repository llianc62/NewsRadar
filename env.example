## 知识库 embedding（knowledge.enabled: true 时必需）
## 默认走本地 Ollama：brew install ollama && brew services start ollama
##                      ollama pull nomic-embed-text   （768 维）
# export KNOWLEDGE_ENABLED="true"
# export KNOWLEDGE_EMBEDDING_BASE_URL="http://localhost:11434/v1"
# export KNOWLEDGE_EMBEDDING_API_KEY="ollama"   # Ollama 不校验 key，填非空值即可
# export KNOWLEDGE_EMBEDDING_MODEL="nomic-embed-text"
# export KNOWLEDGE_EMBEDDING_DIM="768"          # 必须与 knowledge_chunks 建表维度一致
# export KNOWLEDGE_TOP_K="5"

## 抓取代理（HTTP 代理，无认证）
## requests/httpx/boto3/openai SDK 自动读取并尊重 NO_PROXY。
## playwright/crawl4ai 浏览器层由代码显式注入，但不识别 NO_PROXY ——
##   浏览器只抓 WAF 外网站点(huxiu/xueqiu/juejin)，本就全程走代理，无需绕过。
## 本地服务（MinIO 9000 / Ollama 11434 / MCP 8001）与 LLM/S3 靠 NO_PROXY 排除（浏览器不碰它们）。
## 仅支持无认证代理；带用户名密码的 URL 不在支持范围。
# export HTTP_PROXY="http://127.0.0.1:7890"
# export HTTPS_PROXY="http://127.0.0.1:7890"
# export NO_PROXY="localhost,127.0.0.1,::1"
